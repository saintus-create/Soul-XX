15:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"[2026-03-16]"}]," SoulX-Singer-SVC released. The online demo now supports singing voice conversion."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"[2026-02-12]"}]," SoulX-Singer Eval Dataset published on Hugging Face."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"[2026-02-09]"}]," Online demo live on Hugging Face Spaces."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"[2026-02-08]"}]," MIDI Editor deployed on Hugging Face Spaces."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"[2026-02-06]"}]," Inference code and model weights released."]}],"\n"]}]
