17:["$","figure",null,{"data-rehype-pretty-code-figure":"","children":["$","pre",null,{"tabIndex":"0","data-language":"bash","data-theme":"vesper","children":["$","code",null,{"data-language":"bash","data-theme":"vesper","style":{"display":"grid"},"children":["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#FFC799"},"children":"bash"}],["$","span",null,{"style":{"color":"#99FFE4"},"children":" example/preprocess.sh"}],["$","span",null,{"style":{"color":"#99FFE4"},"children":" midi_transcribe=False"}]]}]}]}]}]
