11:[["$","h1",null,{"children":"Singing Voice Conversion (SVC)"}],"\n",["$","p",null,{"children":"SoulX-Singer-SVC converts a source singing recording into the target singer's voice while preserving the original melody, rhythm, and lyrics. Unlike the SVS pipeline, SVC works directly from raw audio — no lyric transcription or MIDI notes are required."}],"\n",["$","h2",null,{"children":"How It Works"}],"\n",["$","p",null,{"children":"SVC fine-tunes SoulX-Singer's generative capability on an audio-to-audio conversion objective. The model:"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":["Extracts the ",["$","strong",null,{"children":"pitch (F0)"}]," and ",["$","strong",null,{"children":"content"}]," from the source audio."]}],"\n",["$","li",null,{"children":["Extracts the ",["$","strong",null,{"children":"timbre"}]," from the target singer prompt."]}],"\n",["$","li",null,{"children":"Synthesizes new audio combining the source content/pitch with the target timbre."}],"\n"]}],"\n",["$","p",null,{"children":"This is fully transcription-free — no intermediate text or MIDI representation is used."}],"\n",["$","h2",null,{"children":"Running SVC Inference"}],"\n",["$","h3",null,{"children":"With the example script"}],"\n",["$","figure",null,{"data-rehype-pretty-code-figure":"","children":["$","pre",null,{"tabIndex":"0","data-language":"bash","data-theme":"vesper","children":["$","code",null,{"data-language":"bash","data-theme":"vesper","style":{"display":"grid"},"children":[["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#FFC799"},"children":"conda"}],["$","span",null,{"style":{"color":"#99FFE4"},"children":" activate"}],["$","span",null,{"style":{"color":"#99FFE4"},"children":" soulxsinger"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#FFC799"},"children":"bash"}],["$","span",null,{"style":{"color":"#99FFE4"},"children":" example/infer_svc.sh"}]]}]]}]}]}],"\n",["$","h3",null,{"children":"Custom inference"}],"\n",["$","figure",null,{"data-rehype-pretty-code-figure":"","children":["$","pre",null,{"tabIndex":"0","data-language":"python","data-theme":"vesper","children":["$","code",null,{"data-language":"python","data-theme":"vesper","style":{"display":"grid"},"children":[["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#A0A0A0"},"children":"from"}],["$","span",null,{"style":{"color":"#FFF"},"children":" soulxsinger.infer_svc "}],["$","span",null,{"style":{"color":"#A0A0A0"},"children":"import"}],["$","span",null,{"style":{"color":"#FFF"},"children":" SoulXSingerSVCInfer"}]]}],"\n",["$","span",null,{"data-line":"","children":" "}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#FFF"},"children":"infer "}],["$","span",null,{"style":{"color":"#A0A0A0"},"children":"="}],["$","span",null,{"style":{"color":"#FFF"},"children":" SoulXSingerSVCInfer("}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#FFF"},"children":"    model_dir"}],["$","span",null,{"style":{"color":"#A0A0A0"},"children":"="}],["$","span",null,{"style":{"color":"#99FFE4"},"children":"\"pretrained_models/SoulX-Singer\""}],["$","span",null,{"style":{"color":"#FFF"},"children":","}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#FFF"},"children":"    device"}],["$","span",null,{"style":{"color":"#A0A0A0"},"children":"="}],["$","span",null,{"style":{"color":"#99FFE4"},"children":"\"cuda\""}],["$","span",null,{"style":{"color":"#FFF"},"children":","}]]}],"\n",["$","span",null,{"data-line":"","children":["$","span",null,{"style":{"color":"#FFF"},"children":")"}]}],"\n",["$","span",null,{"data-line":"","children":" "}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#FFF"},"children":"result "}],["$","span",null,{"style":{"color":"#A0A0A0"},"children":"="}],["$","span",null,{"style":{"color":"#FFF"},"children":" infer.convert("}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#FFF"},"children":"    source_wav"}],["$","span",null,{"style":{"color":"#A0A0A0"},"children":"="}],["$","span",null,{"style":{"color":"#99FFE4"},"children":"\"path/to/source_singing.wav\""}],["$","span",null,{"style":{"color":"#FFF"},"children":",   "}],["$","span",null,{"style":{"color":"#8B8B8B94"},"children":"# audio to convert"}]]}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"color":"#FFF"},"children":"    prompt_wav"}],["$","span",null,{"style":{"color":"#A0A0A0"},"children":"="}],["$","span",null,{"style":{"color":"#99FFE4"},"children":"\"path/to/target_singer.wav\""}],["$","span",null,{"style":{"color":"#FFF"},"children":",    "}],["$","span",null,{"style":{"color":"#8B8B8B94"},"children":"# timbre reference"}]]}],"\n",["$","span",null,{"data-line":"","children":["$","span",null,{"style":{"color":"#FFF"},"children":")"}]}],"\n","$L13","\n","$L14"]}]}]}],"\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20"]
