1c:["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{}],["$","th",null,{"children":"SVS"}],["$","th",null,{"children":"SVC"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Input"}],["$","td",null,{"children":"Text lyrics + pitch"}],["$","td",null,{"children":"Raw audio"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Pitch control"}],["$","td",null,{"children":"Full (F0 or MIDI)"}],["$","td",null,{"children":"Preserved from source"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Requires transcription"}],["$","td",null,{"children":"Yes (automated or manual)"}],["$","td",null,{"children":"No"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Best for"}],["$","td",null,{"children":"New compositions"}],["$","td",null,{"children":"Voice style transfer"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Speed"}],["$","td",null,{"children":"Slower (preprocessing)"}],["$","td",null,{"children":"Faster"}]]}]]}]]}]
1d:["$","h2",null,{"children":"Limitations"}]
1e:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Music bleed"}]," — If the source audio contains heavy background music that is not fully separated, it may bleed into the output. Use a high-quality vocal separator or a clean dry vocal as input."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Extreme pitch ranges"}]," — Conversion quality degrades if the source pitch range is far outside the target singer's natural range."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Language"}]," — SVC is language-agnostic, but very language-specific vocal characteristics (e.g., tonal phonemes in Mandarin) may be imperfectly preserved when converting across languages."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Style"}]," — Unusual vocal styles (extreme vibrato, growling, falsetto) may not transfer cleanly."]}],"\n"]}]
1f:["$","h2",null,{"children":"Tips for Best Results"}]
20:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Use a ",["$","strong",null,{"children":"clean, isolated vocal"}]," for both source and prompt. Vocal separation (",["$","code",null,{"children":"preprocess.sh"}],") helps, but a dry studio recording is ideal."]}],"\n",["$","li",null,{"children":["Keep the ",["$","strong",null,{"children":"prompt recording to 5–15 seconds"}]," — enough to capture stable timbre without over-fitting to a specific phrase."]}],"\n",["$","li",null,{"children":["Match the ",["$","strong",null,{"children":"pitch range"}]," of source to target where possible. Shifting pitch by more than an octave degrades quality."]}],"\n",["$","li",null,{"children":"For cross-lingual conversion (e.g., Mandarin source → English-accented timbre), expect some accent mixing — this is a known limitation."}],"\n"]}]
